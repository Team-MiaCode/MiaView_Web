{
  "name": "miaview-web",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "MiaView Web: embeddable Simai chart preview powered by MiaCode",
  "main": "./sdk/index.mjs",
  "types": "./sdk/index.d.mts",
  "exports": {
    ".": {
      "types": "./sdk/index.d.mts",
      "import": "./sdk/index.mjs"
    }
  },
  "files": [
    "sdk",
    "renderer",
    "backend",
    "README.md"
  ],
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.spec.mjs",
    "check": "node scripts/verify.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check:source": "node scripts/verify.mjs --source",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:firework": "node tests/firework-smoke.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pages": "node tests/pages-smoke.mjs",
    "build:native": "node native/build.mjs",
    "sync:artifacts": "node native/artifacts.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
